---
import { eq } from "drizzle-orm";
import {
  ArrowRight,
  FileText,
  Hand,
  Search,
  SearchX,
  TriangleAlert,
  UserRound,
} from "lucide-react";
import Callout from "@/components/ui/Callout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Tag from "@/components/ui/Tag.astro";
import { buttonVariants, type TagColor } from "@/components/ui/variants";
import { db, schema } from "@/db";
import Layout from "@/layouts/Layout.astro";
import { cn } from "@/lib/cn";
import { searchJobs } from "@/lib/tallo";

const params = Astro.url.searchParams;
const title = params.get("title")?.trim() ?? "";
const place = params.get("place")?.trim() ?? "";
const remote = params.get("remote") === "on";
const recent = Number(params.get("recent")) || undefined;
const cursor = params.get("cursor") ?? undefined;
const searching = title.length >= 2;

let results: Awaited<ReturnType<typeof searchJobs>> | undefined;
let failure: string | undefined;
if (searching) {
  try {
    results = await searchJobs({
      title: [title],
      location: [place, remote ? "remote" : ""].filter(Boolean),
      postedWithin: recent,
      cursor,
    });
  } catch (e) {
    failure = e instanceof Error ? e.message : "Search failed.";
  }
}

const { user } = Astro.locals;
const profile = user
  ? await db.query.profile.findFirst({
      where: eq(schema.profile.userId, user.id),
    })
  : undefined;

const nextPage =
  results?.hasMore && results.next
    ? new URLSearchParams({
        ...Object.fromEntries(params),
        cursor: results.next,
      })
    : undefined;
const examples = [
  "Software engineer",
  "Product designer",
  "Data analyst",
  "Nurse",
  "Marketing manager",
];
const steps = [
  {
    Icon: UserRound,
    head: "Tell us about you",
    body: "Upload a resume or type your details once.",
  },
  {
    Icon: Search,
    head: "Pick a job",
    body: "Search real openings from company career pages.",
  },
  {
    Icon: FileText,
    head: "Get your resume",
    body: "We write a resume and cover letter for that job.",
  },
];
const modeColor: Record<string, TagColor> = {
  remote: "green",
  hybrid: "blue",
  onsite: "gray",
};
const columns =
  "lg:grid-cols-[minmax(0,2.2fr)_minmax(0,1.3fr)_minmax(0,1.2fr)_6rem]";
---
<Layout title="Find jobs">
  <PageHeader Icon={Search} title="Find jobs" description="Search real openings, then get a resume and cover letter written for the one you pick." />

  {user && !profile && (
    <Callout Icon={Hand} tone="yellow" class="mb-5">
      <strong>Start here.</strong> Add your details so we can write your resumes.
      <a href="/profile" class="ml-1 inline-flex items-center gap-1 font-medium underline underline-offset-2">Add my details <ArrowRight className="size-3.5" /></a>
    </Callout>
  )}

  <form method="get" role="search" class="grid gap-3 rounded-lg border bg-card p-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,1.3fr)_auto] sm:items-end">
    <label class="grid gap-1 text-xs font-medium text-muted-foreground">
      Job title
      <input name="title" value={title} required minlength="2" placeholder="e.g. Backend engineer" class="field" />
    </label>
    <label class="grid gap-1 text-xs font-medium text-muted-foreground">
      Where
      <input name="place" value={place} placeholder="City or country (optional)" class="field" />
    </label>
    <button type="submit" class={cn(buttonVariants({ size: "lg" }), "w-full sm:w-auto")}><Search className="size-4" /> Search</button>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm sm:col-span-3">
      <label class="flex items-center gap-2"><input type="checkbox" name="remote" checked={remote} class="size-4 accent-primary" /> Include remote jobs</label>
      <label class="flex items-center gap-2 text-muted-foreground">
        Posted
        <select name="recent" class="field h-8 w-auto py-0">
          <option value="" selected={!recent}>any time</option>
          <option value="7" selected={recent === 7}>in the last week</option>
          <option value="30" selected={recent === 30}>in the last month</option>
        </select>
      </label>
    </div>
  </form>

  {!searching && (
    <>
      <p class="mt-4 flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        Try
        {examples.map((e) => <a href={`/?title=${encodeURIComponent(e)}`} class="tag tag-gray hover:opacity-80">{e}</a>)}
      </p>
      <ol class="mt-8 grid gap-3 md:grid-cols-3">
        {steps.map(({ Icon, head, body }, i) => (
          <li class="flex gap-3 rounded-lg border p-4">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-accent text-muted-foreground"><Icon className="size-4" strokeWidth={1.75} /></span>
            <div>
              <h2 class="font-semibold"><span class="text-muted-foreground">{i + 1}.</span> {head}</h2>
              <p class="mt-0.5 text-muted-foreground">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </>
  )}

  {failure && <Callout Icon={TriangleAlert} tone="red" class="mt-5"><span role="alert">{failure} Please try again in a moment.</span></Callout>}

  {results && (
    <section class="mt-8" aria-label="Search results">
      {results.results.length === 0 ? (
        <Callout Icon={SearchX} class="mt-2">
          <strong>No jobs found.</strong> Try a simpler title, such as "engineer", or remove the place.
        </Callout>
      ) : (
        <>
          <div class={cn("hidden gap-4 border-b px-2 pb-2 text-xs text-muted-foreground lg:grid", columns)} aria-hidden="true">
            <span>Job</span><span>Where</span><span>Pay</span><span>Posted</span>
          </div>
          <ul>
            {results.results.map((job) => (
              <li class="border-b last:border-0">
                <a href={`/jobs/${job.id}`} class={cn("row-hover grid gap-x-4 gap-y-1 rounded-md px-2 py-3 outline-none", columns)}>
                  <span class="min-w-0">
                    <span class="flex min-w-0 items-center gap-2 font-medium"><FileText className="size-4 shrink-0 text-muted-foreground" strokeWidth={1.75} /><span class="truncate">{job.title}</span></span>
                    <span class="block truncate pl-6 text-muted-foreground">{job.company}</span>
                  </span>
                  <span class="flex min-w-0 flex-wrap items-center gap-1.5 text-muted-foreground">
                    {job.workMode && <Tag color={modeColor[job.workMode] ?? "gray"} class="capitalize">{job.workMode}</Tag>}
                    <span class="truncate">{job.location}</span>
                  </span>
                  <span class="truncate text-muted-foreground">{job.pay}</span>
                  <span class="text-muted-foreground">{job.postedAt}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
      {nextPage && (
        <p class="mt-6"><a href={`/?${nextPage}`} class={buttonVariants({ variant: "outline" })}>Show more jobs</a></p>
      )}
    </section>
  )}
</Layout>
