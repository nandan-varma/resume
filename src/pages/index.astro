---
import { and, eq, inArray } from "drizzle-orm";
import {
  ArrowRight,
  FileText,
  Search,
  SlidersHorizontal,
  Sparkles,
  TriangleAlert,
  UserRound,
  X,
} from "lucide-react";
import ResultsBrowser from "@/components/ResultsBrowser";
import SuggestedSearches from "@/components/SuggestedSearches";
import Callout from "@/components/ui/Callout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { buttonVariants } from "@/components/ui/variants";
import { db, schema } from "@/db";
import Layout from "@/layouts/Layout.astro";
import { cn } from "@/lib/cn";
import { hasContent, Resume } from "@/lib/resume";
import { parseSearch, SORTS, WINDOWS } from "@/lib/search";
import { searchJobs } from "@/lib/tallo";

const params = Astro.url.searchParams;
const query = parseSearch(params);

let results: Awaited<ReturnType<typeof searchJobs>> | undefined;
let failure: string | undefined;
if (query.searchable) {
  try {
    results = await searchJobs({
      title: query.title,
      company: query.company,
      location: [...query.place, ...(query.remote ? ["remote"] : [])],
      country: query.country,
      postedWithin: query.postedWithin,
      sort: query.sort,
      cursor: query.cursor,
    });
  } catch (e) {
    failure = e instanceof Error ? e.message : "Search failed.";
  }
}

const { user } = Astro.locals;
const profile = user
  ? await db.query.profile.findFirst({
      where: eq(schema.profile.userId, user.id),
    })
  : undefined;
const ready = profile ? hasContent(Resume.parse(profile.resume)) : false;

// Jobs the user already made a resume for.
const made: string[] = [];
if (user && results?.results.length) {
  const rows = await db.query.application.findMany({
    where: and(
      eq(schema.application.userId, user.id),
      inArray(
        schema.application.talloId,
        results.results.map((j) => j.id),
      ),
    ),
    columns: { talloId: true },
  });
  made.push(...rows.map((r) => r.talloId));
}

const nextPage =
  results?.hasMore && results.next
    ? `/?${new URLSearchParams({
        ...Object.fromEntries(params),
        cursor: results.next,
      })}`
    : undefined;

const value = (list: string[]) => list.join(", ");

// Filters that live under "More filters", shown as chips you can remove with one click.
const without = (key: string) => {
  const next = new URLSearchParams(params);
  next.delete(key);
  next.delete("cursor");
  next.delete("job");
  return `/?${next}`;
};
const windowLabel = WINDOWS.find(
  (w) => w.value === String(query.postedWithin ?? ""),
)?.label;
const chips = [
  query.company.length > 0 && {
    label: `Company: ${value(query.company)}`,
    href: without("company"),
  },
  query.country.length > 0 && {
    label: `Country: ${value(query.country)}`,
    href: without("country"),
  },
  query.postedWithin && {
    label: windowLabel ?? "Recent",
    href: without("recent"),
  },
  query.sort !== "relevance" && {
    label: `Sort: ${SORTS.find((s) => s.value === query.sort)?.label}`,
    href: without("sort"),
  },
].filter(Boolean) as { label: string; href: string }[];

const steps = [
  {
    Icon: UserRound,
    title: "Tell us about you",
    text: "Upload your resume once. We never invent facts, so everything we write comes from you.",
  },
  {
    Icon: Search,
    title: "Pick a real job",
    text: "Search live openings and see how your skills line up before you spend any time.",
  },
  {
    Icon: FileText,
    title: "Get your resume",
    text: "A one-page resume and cover letter written for that job. Edit anything, then save as PDF.",
  },
];
---
<Layout title="Find jobs">
  <PageHeader Icon={Search} title="Find jobs" description="Search real openings, then get a resume and cover letter written for the one you pick." />

  {user && !profile && (
    <a href="/profile" class="lift group mb-5 flex items-center gap-4 rounded-xl border border-primary/40 bg-[color-mix(in_srgb,var(--primary)_7%,var(--card))] p-4">
      <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground"><Sparkles className="size-5" /></span>
      <span class="min-w-0 flex-1">
        <span class="block font-semibold">Start here: add your details (about a minute)</span>
        <span class="block text-muted-foreground">Upload your resume and we fill in the rest. Then every job is one click from a tailored resume.</span>
      </span>
      <ArrowRight className="size-5 shrink-0 transition-transform group-hover:translate-x-1" />
    </a>
  )}

  <form id="search" method="get" role="search" class="rounded-xl border bg-card p-3 shadow-xs">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_auto_auto] lg:items-end">
      <label class="grid gap-1 text-xs font-medium text-muted-foreground">
        Job title or keyword
        <input name="title" value={value(query.title)} placeholder="e.g. backend engineer" class="field" autocomplete="off" />
      </label>
      <label class="grid gap-1 text-xs font-medium text-muted-foreground">
        Where
        <input name="place" value={value(query.place)} placeholder="City or region" class="field" autocomplete="off" />
      </label>
      <label class="flex h-9 items-center gap-2 text-sm"><input type="checkbox" name="remote" checked={query.remote} class="size-4 accent-primary" /> Remote too</label>
      <button type="submit" class={cn(buttonVariants({ size: "lg" }), "w-full lg:w-auto")}><Search className="size-4" /> Search</button>
    </div>

    <details class="group mt-3 border-t pt-2" open={chips.length > 0}>
      <summary class="row-hover inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-muted-foreground select-none">
        <SlidersHorizontal className="size-3.5" /> More filters
      </summary>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <label class="grid gap-1 text-xs font-medium text-muted-foreground">Company
          <input name="company" value={value(query.company)} placeholder="e.g. Stripe" class="field" />
        </label>
        <label class="grid gap-1 text-xs font-medium text-muted-foreground">Country codes
          <input name="country" value={value(query.country)} placeholder="US, CA" maxlength="20" class="field" />
        </label>
        <label class="grid gap-1 text-xs font-medium text-muted-foreground">Posted
          <select name="recent" class="field">
            {WINDOWS.map((w) => <option value={w.value} selected={String(query.postedWithin ?? "") === w.value}>{w.label}</option>)}
          </select>
        </label>
        <label class="grid gap-1 text-xs font-medium text-muted-foreground">Sort by
          <select name="sort" class="field">
            {SORTS.map((o) => <option value={o.value} selected={query.sort === o.value}>{o.label}</option>)}
          </select>
        </label>
      </div>
    </details>
  </form>

  {chips.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2" aria-label="Active filters">
      {chips.map((c) => (
        <a href={c.href} class="press inline-flex h-7 items-center gap-1 rounded-full border bg-card px-2.5 text-xs transition-colors hover:bg-accent" aria-label={`Remove filter: ${c.label}`}>
          {c.label}<X className="size-3 text-muted-foreground" />
        </a>
      ))}
    </div>
  )}

  {!query.searchable && user && ready && <SuggestedSearches client:load />}

  {!query.searchable && !(user && ready) && (
    <ol class="mt-8 grid gap-3 md:grid-cols-3" aria-label="How it works">
      {steps.map(({ Icon, title, text }, i) => (
        <li class="stagger rounded-xl border bg-card p-4" style={`--i:${i + 1}`}>
          <span class="mb-3 flex size-9 items-center justify-center rounded-full bg-muted text-muted-foreground"><Icon className="size-4.5" /></span>
          <p class="font-semibold">{i + 1}. {title}</p>
          <p class="mt-1 text-muted-foreground">{text}</p>
        </li>
      ))}
    </ol>
  )}

  {failure && <Callout Icon={TriangleAlert} tone="red" class="mt-5"><span role="alert">{failure} Please try again in a moment.</span></Callout>}

  {results && <ResultsBrowser client:load jobs={results.results} made={made} next={nextPage} capped={results.capped} />}
</Layout>

<script>
  // Selects and the remote box apply as soon as you change them.
  document.addEventListener("change", (e) => {
    const t = e.target as HTMLElement;
    const form = t.closest<HTMLFormElement>("form#search");
    if (form && (t instanceof HTMLSelectElement || (t instanceof HTMLInputElement && t.type === "checkbox"))) {
      form.requestSubmit();
    }
  });
</script>
