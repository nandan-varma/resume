---
import { and, eq, inArray } from "drizzle-orm";
import {
  ArrowRight,
  FileText,
  Hand,
  Search,
  SearchX,
  TriangleAlert,
} from "lucide-react";
import SuggestedSearches from "@/components/SuggestedSearches";
import Callout from "@/components/ui/Callout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Tag from "@/components/ui/Tag.astro";
import { buttonVariants, type TagColor } from "@/components/ui/variants";
import { db, schema } from "@/db";
import Layout from "@/layouts/Layout.astro";
import { cn } from "@/lib/cn";
import { hasContent, Resume } from "@/lib/resume";
import { parseSearch, SORTS, WINDOWS } from "@/lib/search";
import { searchJobs } from "@/lib/tallo";

const params = Astro.url.searchParams;
const query = parseSearch(params);

let results: Awaited<ReturnType<typeof searchJobs>> | undefined;
let failure: string | undefined;
if (query.searchable) {
  try {
    results = await searchJobs({
      title: query.title,
      company: query.company,
      location: [...query.place, ...(query.remote ? ["remote"] : [])],
      country: query.country,
      postedWithin: query.postedWithin,
      sort: query.sort,
      cursor: query.cursor,
    });
  } catch (e) {
    failure = e instanceof Error ? e.message : "Search failed.";
  }
}

const { user } = Astro.locals;
const profile = user
  ? await db.query.profile.findFirst({
      where: eq(schema.profile.userId, user.id),
    })
  : undefined;
const ready = profile ? hasContent(Resume.parse(profile.resume)) : false;

// Jobs the user already made a resume for.
const made = new Map<string, string>();
if (user && results?.results.length) {
  const rows = await db.query.application.findMany({
    where: and(
      eq(schema.application.userId, user.id),
      inArray(
        schema.application.talloId,
        results.results.map((j) => j.id),
      ),
    ),
    columns: { id: true, talloId: true },
  });
  for (const row of rows) {
    made.set(row.talloId, row.id);
  }
}

const nextPage =
  results?.hasMore && results.next
    ? new URLSearchParams({
        ...Object.fromEntries(params),
        cursor: results.next,
      })
    : undefined;
const modeColor: Record<string, TagColor> = {
  remote: "green",
  hybrid: "blue",
  onsite: "gray",
};
const columns =
  "lg:grid-cols-[minmax(0,2.2fr)_minmax(0,1.3fr)_minmax(0,1.2fr)_6rem]";
const value = (list: string[]) => list.join(", ");
---
<Layout title="Find jobs">
  <PageHeader Icon={Search} title="Find jobs" description="Search real openings, then get a resume and cover letter written for the one you pick." />

  {user && !profile && (
    <Callout Icon={Hand} tone="yellow" class="mb-5">
      <strong>Start here.</strong> Add your details so we can write your resumes.
      <a href="/profile" class="ml-1 inline-flex items-center gap-1 font-medium underline underline-offset-2">Add my details <ArrowRight className="size-3.5" /></a>
    </Callout>
  )}

  <form method="get" role="search" class="grid gap-3 rounded-lg border bg-card p-3 sm:grid-cols-2 lg:grid-cols-[repeat(3,minmax(0,1fr))_auto] lg:items-end">
    <label class="grid gap-1 text-xs font-medium text-muted-foreground">
      Job title
      <input name="title" value={value(query.title)} placeholder="e.g. backend engineer, platform engineer" class="field" />
    </label>
    <label class="grid gap-1 text-xs font-medium text-muted-foreground">
      Company
      <input name="company" value={value(query.company)} placeholder="e.g. Stripe" class="field" />
    </label>
    <label class="grid gap-1 text-xs font-medium text-muted-foreground">
      Where
      <input name="place" value={value(query.place)} placeholder="City or region, e.g. Seattle" class="field" />
    </label>
    <button type="submit" class={cn(buttonVariants({ size: "lg" }), "w-full lg:w-auto")}><Search className="size-4" /> Search</button>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm sm:col-span-2 lg:col-span-4">
      <label class="flex items-center gap-2"><input type="checkbox" name="remote" checked={query.remote} class="size-4 accent-primary" /> Include remote jobs</label>
      <label class="flex items-center gap-2 text-muted-foreground">
        Country
        <input name="country" value={value(query.country)} placeholder="US, CA" maxlength="20" aria-label="Country codes" class="field h-8 w-24" />
      </label>
      <label class="flex items-center gap-2 text-muted-foreground">
        Posted
        <select name="recent" class="field h-8 w-auto py-0">
          {WINDOWS.map((w) => <option value={w.value} selected={String(query.postedWithin ?? "") === w.value}>{w.label}</option>)}
        </select>
      </label>
      <label class="flex items-center gap-2 text-muted-foreground">
        Sort
        <select name="sort" class="field h-8 w-auto py-0">
          {SORTS.map((o) => <option value={o.value} selected={query.sort === o.value}>{o.label}</option>)}
        </select>
      </label>
    </div>
  </form>

  {!query.searchable && user && ready && <SuggestedSearches client:load />}

  {failure && <Callout Icon={TriangleAlert} tone="red" class="mt-5"><span role="alert">{failure} Please try again in a moment.</span></Callout>}

  {results && (
    <section class="mt-8" aria-label="Search results">
      {results.results.length === 0 ? (
        <Callout Icon={SearchX} class="mt-2">No jobs found for this search.</Callout>
      ) : (
        <>
          <div class={cn("hidden gap-4 border-b px-2 pb-2 text-xs text-muted-foreground lg:grid", columns)} aria-hidden="true">
            <span>Job</span><span>Where</span><span>Pay</span><span>Posted</span>
          </div>
          <ul>
            {results.results.map((job) => (
              <li class="border-b last:border-0">
                <a href={`/jobs/${job.id}`} class={cn("row-hover grid gap-x-4 gap-y-1 rounded-md px-2 py-3 outline-none", columns)}>
                  <span class="min-w-0">
                    <span class="flex min-w-0 items-center gap-2 font-medium">
                      <FileText className="size-4 shrink-0 text-muted-foreground" strokeWidth={1.75} />
                      <span class="truncate">{job.title}</span>
                      {made.has(job.id) && <Tag color="blue" class="shrink-0">Resume made</Tag>}
                    </span>
                    <span class="block truncate pl-6 text-muted-foreground">
                      {job.company}{job.department && ` · ${job.department}`}{job.employmentType && ` · ${job.employmentType}`}
                    </span>
                  </span>
                  <span class="flex min-w-0 flex-wrap items-center gap-1.5 text-muted-foreground">
                    {job.workMode && <Tag color={modeColor[job.workMode] ?? "gray"} class="capitalize">{job.workMode}</Tag>}
                    <span class="truncate">{job.location}</span>
                    {job.locations > 1 && <span class="shrink-0 text-xs">+{job.locations - 1} more</span>}
                  </span>
                  <span class="truncate text-muted-foreground">{job.pay}</span>
                  <span class="text-muted-foreground">{job.postedAt}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
      <p class="mt-6 flex items-center gap-3 text-xs text-muted-foreground">
        {nextPage && <a href={`/?${nextPage}`} class={buttonVariants({ variant: "outline", size: "sm" })}>Next page</a>}
        {results.capped && <span>Results are capped at 300. Narrow the search to see more.</span>}
      </p>
    </section>
  )}
</Layout>
