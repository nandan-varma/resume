---
import { eq } from "drizzle-orm";
import { IdCard } from "lucide-react";
import ProfileEditor from "@/components/ProfileEditor";
import PageHeader from "@/components/ui/PageHeader.astro";
import { db, schema } from "@/db";
import Layout from "@/layouts/Layout.astro";
import {
  defaultPrefs,
  emptyResume,
  hasContent,
  Prefs,
  Resume,
} from "@/lib/resume";

const profile = await db.query.profile.findFirst({
  where: eq(schema.profile.userId, Astro.locals.user?.id ?? ""),
});
const resume = Resume.parse(profile?.resume ?? emptyResume());
const prefs = Prefs.parse(profile?.prefs ?? defaultPrefs());
---
<Layout title="Profile">
  <PageHeader Icon={IdCard} title="Your profile" description="This is your master resume. Everything we write comes from it, and we never make facts up." />
  <ProfileEditor client:load resume={resume} prefs={prefs} welcome={!hasContent(resume)} />
</Layout>
