---
import { eq } from "drizzle-orm";
import { FileUp, IdCard } from "lucide-react";
import ImportResume from "@/components/ImportResume";
import SchemaForm from "@/components/SchemaForm";
import Callout from "@/components/ui/Callout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { db, schema } from "@/db";
import Layout from "@/layouts/Layout.astro";
import {
  defaultPrefs,
  emptyResume,
  hasContent,
  Prefs,
  Resume,
  toFormSchema,
} from "@/lib/resume";

const profile = await db.query.profile.findFirst({
  where: eq(schema.profile.userId, Astro.locals.user?.id ?? ""),
});
const resume = Resume.parse(profile?.resume ?? emptyResume());
const prefs = Prefs.parse(profile?.prefs ?? defaultPrefs());

const area = { "ui:widget": "textarea" };
const resumeUi = {
  basics: { summary: area },
  summaries: { items: area },
  work: { items: { highlights: { items: area } } },
  projects: { items: { highlights: { items: area } } },
  education: { items: { details: area } },
  leadership: { items: { details: area } },
  notes: area,
};
const prefsUi = { rules: area };
---
<Layout title="My details" width="text">
  <PageHeader Icon={IdCard} title="My details" description="Everything we write comes from here. We never make facts up, so the more you add, the better your resumes." />

  <Callout Icon={FileUp} class="mb-6">
    <p class="font-medium">{hasContent(resume) ? "Start over from a new resume" : "Quick start"}</p>
    <p class="mt-1 mb-3 text-muted-foreground">Upload an existing resume and we will fill in the form for you.</p>
    <ImportResume client:load />
  </Callout>

  <h2 class="block-heading mt-2">Your information</h2>
  <SchemaForm client:load schema={toFormSchema(Resume)} uiSchema={resumeUi} data={resume} action="saveResume" field="resume" submitLabel="Save my details" />

  <h2 class="block-heading">How we write</h2>
  <SchemaForm client:load schema={toFormSchema(Prefs)} uiSchema={prefsUi} data={prefs} action="savePrefs" field="prefs" submitLabel="Save preferences" />
</Layout>
