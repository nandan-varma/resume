---
import { and, eq } from "drizzle-orm";
import {
  ArrowLeft,
  CheckCircle2,
  Lightbulb,
  TriangleAlert,
} from "lucide-react";
import ApplicationEditor from "@/components/ApplicationEditor";
import DeleteResume from "@/components/DeleteResume";
import Callout from "@/components/ui/Callout.astro";
import Property from "@/components/ui/Property.astro";
import Tag from "@/components/ui/Tag.astro";
import type { TagColor } from "@/components/ui/variants";
import { db, schema } from "@/db";
import Layout from "@/layouts/Layout.astro";
import { Prefs, Resume } from "@/lib/resume";

const userId = Astro.locals.user?.id ?? "";
const row = await db.query.application.findFirst({
  where: and(
    eq(schema.application.id, Astro.params.id ?? ""),
    eq(schema.application.userId, userId),
  ),
});
if (!row) {
  return Astro.rewrite("/404");
}
const profile = await db.query.profile.findFirst({
  where: eq(schema.profile.userId, userId),
});

const { match } = row;
const level: Record<string, { color: TagColor; label: string }> = {
  strong: { color: "green", label: "Strong match" },
  good: { color: "blue", label: "Good match" },
  stretch: { color: "yellow", label: "A stretch" },
};
---
<Layout title={`${row.role} at ${row.company}`}>
  <div class="print:hidden">
    <a href="/resumes" class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground"><ArrowLeft className="size-3.5" /> My resumes</a>
    <h1 class="page-title mt-3 mb-1">{row.role}</h1>
    <p class="mb-6 text-base text-muted-foreground">{row.company}</p>
  </div>

  <ApplicationEditor
    client:load
    id={row.id}
    talloId={row.talloId}
    role={row.role}
    company={row.company}
    applyUrl={row.applyUrl}
    applied={row.applied}
    resume={Resume.parse(row.resume)}
    coverLetter={row.coverLetter}
    master={Resume.parse(profile?.resume ?? {})}
    paper={Prefs.parse(profile?.prefs ?? {}).paper}
    isNew={Astro.url.searchParams.has("new")}
  >
    <div slot="aside" class="grid gap-4">
      <dl class="grid gap-1 rounded-xl border bg-card p-4">
        <Property label="Match"><Tag color={level[match.level]?.color ?? "gray"}>{level[match.level]?.label}</Tag></Property>
        {match.confidence && <Property label="Callback odds">{match.confidence}</Property>}
        {match.roleType && <Property label="Role type"><Tag color="purple">{match.roleType}</Tag></Property>}
      </dl>
      {match.blockers.length > 0 && (
        <Callout Icon={TriangleAlert} tone="red">
          <p class="mb-1 font-medium">Check before you apply</p>
          <ul class="list-disc pl-5">{match.blockers.map((b) => <li>{b}</li>)}</ul>
        </Callout>
      )}
      <Callout Icon={CheckCircle2} tone="green">
        <p class="mb-1 font-medium">Why you fit</p>
        <ul class="list-disc pl-5">{match.reasons.map((r) => <li>{r}</li>)}</ul>
      </Callout>
      {match.gaps.length > 0 && (
        <Callout Icon={Lightbulb} tone="yellow">
          <p class="mb-1 font-medium">What could be stronger</p>
          <ul class="list-disc pl-5">{match.gaps.map((g) => <li>{g}</li>)}</ul>
        </Callout>
      )}
      <DeleteResume client:load id={row.id} />
    </div>
  </ApplicationEditor>
</Layout>
