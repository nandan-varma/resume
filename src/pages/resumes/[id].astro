---
import type { RJSFSchema } from "@rjsf/utils";
import { and, eq } from "drizzle-orm";
import {
  ArrowLeft,
  CheckCircle2,
  ChevronRight,
  Lightbulb,
  TriangleAlert,
} from "lucide-react";
import CopyButton from "@/components/CopyButton";
import DeleteResume from "@/components/DeleteResume";
import ResumeToolbar from "@/components/ResumeToolbar";
import ResumeView from "@/components/ResumeView.astro";
import SchemaForm from "@/components/SchemaForm";
import TailorButton from "@/components/TailorButton";
import Callout from "@/components/ui/Callout.astro";
import Property from "@/components/ui/Property.astro";
import Tag from "@/components/ui/Tag.astro";
import type { TagColor } from "@/components/ui/variants";
import { db, schema } from "@/db";
import Layout from "@/layouts/Layout.astro";
import { Resume, toFormSchema } from "@/lib/resume";

const row = await db.query.application.findFirst({
  where: and(
    eq(schema.application.id, Astro.params.id ?? ""),
    eq(schema.application.userId, Astro.locals.user?.id ?? ""),
  ),
});
if (!row) {
  return new Response("Not found", { status: 404 });
}

const { match } = row;
const resume = Resume.parse(row.resume);
const level: Record<string, { color: TagColor; label: string }> = {
  strong: { color: "green", label: "Strong match" },
  good: { color: "blue", label: "Good match" },
  stretch: { color: "yellow", label: "A stretch" },
};

const area = { "ui:widget": "textarea" };
const editSchema: RJSFSchema = {
  type: "object",
  properties: {
    resume: toFormSchema(Resume),
    coverLetter: { type: "string", title: "Cover letter" },
  },
};
const editUi = {
  coverLetter: { "ui:widget": "textarea", "ui:options": { rows: 14 } },
  resume: {
    basics: { summary: area },
    work: { items: { highlights: { items: area } } },
    projects: { items: { highlights: { items: area } } },
    summaries: { "ui:widget": "hidden" },
    notes: { "ui:widget": "hidden" },
  },
};
---
<Layout title={`${row.role} at ${row.company}`}>
  <div class="print:hidden">
    <a href="/resumes" class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground"><ArrowLeft className="size-3.5" /> My resumes</a>
    <h1 class="page-title mt-3">{row.role}</h1>
    <p class="mt-1 text-base text-muted-foreground">{row.company}</p>
  </div>

  <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] print:block">
    <aside class="grid content-start gap-6 lg:sticky lg:top-8 lg:self-start print:hidden">
      <ResumeToolbar client:load id={row.id} applied={row.applied} applyUrl={row.applyUrl} />

      <dl class="grid gap-1">
        <Property label="Match"><Tag color={level[match.level]?.color ?? "gray"}>{level[match.level]?.label}</Tag></Property>
        {match.confidence && <Property label="Confidence">{match.confidence}</Property>}
        {match.roleType && <Property label="Role type"><Tag color="purple">{match.roleType}</Tag></Property>}
        <Property label="Page"><span id="fit-status" aria-live="polite" class="text-muted-foreground">Checking…</span></Property>
      </dl>

      <div id="shorten" hidden><TailorButton client:load talloId={row.talloId} shorter label="Make it shorter" variant="outline" /></div>

      {match.blockers.length > 0 && (
        <Callout Icon={TriangleAlert} tone="red">
          <p class="mb-1 font-medium">Check before you apply</p>
          <ul class="list-disc pl-5">{match.blockers.map((b) => <li>{b}</li>)}</ul>
        </Callout>
      )}
      <Callout Icon={CheckCircle2} tone="green">
        <p class="mb-1 font-medium">Why you fit</p>
        <ul class="list-disc pl-5">{match.reasons.map((r) => <li>{r}</li>)}</ul>
      </Callout>
      {match.gaps.length > 0 && (
        <Callout Icon={Lightbulb} tone="yellow">
          <p class="mb-1 font-medium">What could be stronger</p>
          <ul class="list-disc pl-5">{match.gaps.map((g) => <li>{g}</li>)}</ul>
        </Callout>
      )}
      <DeleteResume client:load id={row.id} />
    </aside>

    <div class="min-w-0">
      <!-- The page keeps its real size; a few lines of script scale it to the screen width. -->
      <div id="sheet-wrap" class="overflow-hidden rounded-md border bg-white shadow-[var(--shadow-pop)] print:overflow-visible print:rounded-none print:border-0 print:shadow-none"><ResumeView resume={resume} /></div>

      <div class="print:hidden">
        <h2 class="block-heading flex items-center justify-between">Cover letter <CopyButton client:load text={row.coverLetter} /></h2>
        <p class="max-w-3xl text-[0.9375rem] leading-7 whitespace-pre-wrap">{row.coverLetter}</p>

        <details class="group mt-8 rounded-lg border">
          <summary class="row-hover flex items-center gap-1.5 rounded-lg px-3 py-2.5 font-medium"><ChevronRight className="size-4 text-muted-foreground transition-transform group-open:rotate-90" /> Edit the words</summary>
          <div class="border-t p-4">
            <SchemaForm client:load schema={editSchema} uiSchema={editUi} data={{ resume, coverLetter: row.coverLetter }} action="saveApplication" payload={{ id: row.id }} reloadOnSave submitLabel="Save and refresh" />
          </div>
        </details>
      </div>
    </div>
  </div>
</Layout>

<script>
  const wrap = document.getElementById("sheet-wrap");
  const sheet = document.getElementById("resume-sheet");
  const content = document.getElementById("resume-content");
  const status = document.getElementById("fit-status");
  const shorten = document.getElementById("shorten");

  if (wrap && sheet && content && status && shorten) {
    // Is there still room on one US Letter page?
    const style = getComputedStyle(sheet);
    const room = sheet.clientHeight - Number.parseFloat(style.paddingTop) - Number.parseFloat(style.paddingBottom);
    const fits = content.offsetHeight <= room;
    status.textContent = fits ? "Fits on one page ✓" : "Runs over one page";
    shorten.hidden = fits;

    // Scale the fixed-size page to the width of its column (up to 1.2x).
    const fit = () => {
      const scale = Math.min(wrap.clientWidth / sheet.offsetWidth, 1.2);
      sheet.style.transform = `scale(${scale})`;
      sheet.style.marginLeft = `${Math.max(0, (wrap.clientWidth - sheet.offsetWidth * scale) / 2)}px`;
      wrap.style.height = `${sheet.offsetHeight * scale}px`;
    };
    const reset = () => {
      sheet.style.transform = "";
      sheet.style.marginLeft = "";
      wrap.style.height = "";
    };
    new ResizeObserver(fit).observe(wrap);
    fit();
    addEventListener("beforeprint", reset);
    addEventListener("afterprint", fit);
  }
</script>
