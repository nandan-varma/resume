---
import AuthPanel from "@/components/AuthPanel";
import Card from "@/components/ui/Card.astro";
import Layout from "@/layouts/Layout.astro";
import { enabledProviders } from "@/lib/auth";

const requested = Astro.url.searchParams.get("next") ?? "/";
// Only allow same-site paths, never "//evil.com".
const next =
  requested.startsWith("/") && !requested.startsWith("//") ? requested : "/";

if (Astro.locals.user) {
  return Astro.redirect(next);
}
---
<Layout title="Sign in" width="narrow">
  <Card class="mt-8">
    <h1 class="text-2xl font-semibold tracking-tight">Welcome</h1>
    <p class="mt-1 mb-6 text-sm text-muted-foreground">
      Sign in to save your details and make resumes. No password to remember.
    </p>
    <AuthPanel client:load next={next} {...enabledProviders} />
  </Card>
</Layout>
