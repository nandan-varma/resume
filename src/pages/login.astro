---
import AuthPanel from "@/components/AuthPanel";
import Layout from "@/layouts/Layout.astro";
import { enabledProviders } from "@/lib/auth";

const requested = Astro.url.searchParams.get("next") ?? "/";
// Only allow same-site paths, never "//evil.com".
const next =
  requested.startsWith("/") && !requested.startsWith("//") ? requested : "/";

if (Astro.locals.user) {
  return Astro.redirect(next);
}
---
<Layout title="Sign in" width="text">
  <div class="mx-auto mt-6 max-w-sm sm:mt-16">
    <img src="/brand/icon.svg" alt="" class="mb-6 size-12 rounded-lg" />
    <h1 class="text-3xl font-bold tracking-tight">Welcome to JobMatch</h1>
    <p class="mt-2 mb-8 text-base text-muted-foreground">
      Sign in to save your details and make resumes. There is no password to remember.
    </p>
    <AuthPanel client:load next={next} {...enabledProviders} />
  </div>
</Layout>
