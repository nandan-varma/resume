---
import { and, eq } from "drizzle-orm";
import { ExternalLink } from "lucide-react";
import TailorButton from "@/components/TailorButton";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import { buttonVariants } from "@/components/ui/variants";
import { db, schema } from "@/db";
import Layout from "@/layouts/Layout.astro";
import { hasContent } from "@/lib/resume";
import { getJob } from "@/lib/tallo";

const { id } = Astro.params;
const job = await getJob(id ?? "");
if (!job) {
  Astro.response.status = 404;
}

const { user } = Astro.locals;
const profile = user
  ? await db.query.profile.findFirst({
      where: eq(schema.profile.userId, user.id),
    })
  : undefined;
const existing =
  user && job
    ? await db.query.application.findFirst({
        where: and(
          eq(schema.application.userId, user.id),
          eq(schema.application.talloId, job.id),
        ),
        columns: { id: true },
      })
    : undefined;
const ready = profile ? hasContent(profile.resume) : false;
const here = encodeURIComponent(Astro.url.pathname);
---
<Layout title={job?.title ?? "Job not found"}>
  {!job ? (
    <Card class="mx-auto max-w-xl text-center">
      <h1 class="text-xl font-semibold">This job is no longer listed</h1>
      <p class="mt-1 mb-4 text-sm text-muted-foreground">It may have been filled or taken down.</p>
      <a href="/" class={buttonVariants()}>Back to search</a>
    </Card>
  ) : (
    <div class="grid gap-8 lg:grid-cols-[1fr_20rem]">
      <article>
        <a href="/" class="text-sm text-muted-foreground hover:text-foreground">← Back to search</a>
        <h1 class="mt-2 text-balance text-3xl font-semibold tracking-tight">{job.title}</h1>
        <p class="mt-1 text-lg text-muted-foreground">{job.company}</p>
        <p class="mt-4 flex flex-wrap gap-2">
          {job.location && <Badge variant="outline">{job.location}</Badge>}
          {job.workMode && <Badge variant="success" class="capitalize">{job.workMode}</Badge>}
          {job.pay && <Badge variant="outline">{job.pay}</Badge>}
          {job.employmentType && <Badge variant="outline">{job.employmentType}</Badge>}
          {job.postedAt && <Badge variant="outline">Posted {job.postedAt}</Badge>}
        </p>
        <h2 class="mt-8 mb-2 text-sm font-semibold uppercase tracking-wide text-muted-foreground">About the job</h2>
        <div class="whitespace-pre-wrap text-sm leading-relaxed">{job.description}</div>
      </article>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <Card class="grid gap-3">
          <h2 class="font-semibold">Apply with a resume made for this job</h2>
          {!user ? (
            <a href={`/login?next=${here}`} class={buttonVariants({ size: "lg" })}>Sign in to start</a>
          ) : !ready ? (
            <>
              <p class="text-sm text-muted-foreground">First, tell us about yourself. It takes a minute.</p>
              <a href="/profile" class={buttonVariants({ size: "lg" })}>Add my details</a>
            </>
          ) : existing ? (
            <>
              <a href={`/resumes/${existing.id}`} class={buttonVariants({ size: "lg" })}>Open my resume</a>
              <TailorButton client:load talloId={job.id} variant="outline" label="Make a fresh version" />
            </>
          ) : (
            <TailorButton client:load talloId={job.id} />
          )}
          <a href={job.applyUrl} target="_blank" rel="noopener noreferrer" class={buttonVariants({ variant: "outline" })}>
            Apply on company site <ExternalLink className="size-4" />
          </a>
        </Card>
      </aside>
    </div>
  )}
</Layout>
