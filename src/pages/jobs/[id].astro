---
import { ArrowLeft, FileX } from "lucide-react";
import JobDetail from "@/components/JobDetail";
import { buttonVariants } from "@/components/ui/variants";
import Layout from "@/layouts/Layout.astro";
import { jobDetail } from "@/lib/job-detail";

const data = await jobDetail(
  Astro.locals.user?.id ?? null,
  Astro.params.id ?? "",
);
if (!data) {
  Astro.response.status = 404;
}
---
<Layout title={data?.job.title ?? "Job not found"}>
  {!data ? (
    <div class="max-w-xl">
      <span class="mb-3 flex size-10 items-center justify-center rounded-lg border text-muted-foreground"><FileX className="size-5" strokeWidth={1.75} /></span>
      <h1 class="page-title">This job is no longer listed</h1>
      <p class="mt-1 mb-5 text-muted-foreground">It may have been filled or taken down.</p>
      <a href="/" class={buttonVariants()}>Back to search</a>
    </div>
  ) : (
    <>
      <a id="back-to-search" href="/" class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground"><ArrowLeft className="size-3.5" /> Back to results</a>
      <div class="mt-3"><JobDetail client:load data={data} /></div>
    </>
  )}
</Layout>

<script>
  // Lead back to the search you came from.
  document.addEventListener("astro:page-load", () => {
    const back = document.getElementById("back-to-search");
    if (!back) return;
    try {
      const last = sessionStorage.getItem("lastSearch");
      if (last) back.setAttribute("href", `/?${last}`);
    } catch {
      // Private mode: keep the plain link.
    }
  });
</script>
