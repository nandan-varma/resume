---
import { cn } from "@/lib/cn";
import { avatarFor } from "@/lib/links";

type Props = { name: string; class?: string };
const { name, class: className } = Astro.props;
const { initial, color } = avatarFor(name);
---
<span
  aria-hidden="true"
  class={cn("flex size-9 shrink-0 items-center justify-center rounded-lg text-sm font-semibold", className)}
  style={`background: var(--tag-${color}-bg); color: var(--tag-${color}-fg)`}
>{initial}</span>
