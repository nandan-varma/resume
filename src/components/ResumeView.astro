---
import type { Resume } from "@/lib/resume";

type Props = { resume: Resume };
const { resume } = Astro.props;
const { basics, work, education, projects, skills, leadership } = resume;
const contact = [
  basics.email,
  basics.phone,
  basics.location,
  ...basics.links.map((l) => l.url || l.label),
].filter(Boolean);
---
<div class="resume-sheet" id="resume-sheet">
  <div id="resume-content">
    <header class="rs-head">
      <h1>{basics.name}</h1>
      {basics.headline && <p class="rs-headline">{basics.headline}</p>}
      <p class="rs-contact">{contact.join("  ·  ")}</p>
    </header>

    {basics.summary && (
      <section>
        <h2>Summary</h2>
        <p>{basics.summary}</p>
      </section>
    )}

    {work.length > 0 && (
      <section>
        <h2>Experience</h2>
        {work.map((job) => (
          <article>
            <div class="row">
              <p><strong>{job.position}</strong>, {job.company}{job.location && <span class="muted"> · {job.location}</span>}</p>
              <span class="date">{[job.start, job.end].filter(Boolean).join(" – ")}</span>
            </div>
            <ul>{job.highlights.map((h) => <li>{h}</li>)}</ul>
          </article>
        ))}
      </section>
    )}

    {projects.length > 0 && (
      <section>
        <h2>Projects</h2>
        {projects.map((p) => (
          <article>
            <div class="row">
              <p><strong>{p.name}</strong>{p.url && <span class="muted"> · {p.url}</span>}</p>
              <span class="date">{p.year}</span>
            </div>
            {p.stack && <p class="stack">{p.stack}</p>}
            <ul>{p.highlights.map((h) => <li>{h}</li>)}</ul>
          </article>
        ))}
      </section>
    )}

    {skills.length > 0 && (
      <section>
        <h2>Skills</h2>
        <dl class="skills">
          {skills.map((s) => (<><dt>{s.group}</dt><dd>{s.items}</dd></>))}
        </dl>
      </section>
    )}

    {leadership.length > 0 && (
      <section>
        <h2>Leadership</h2>
        {leadership.map((l) => (
          <p class="lead"><strong>{l.role}</strong>, {l.org}{l.dates && <span class="muted"> · {l.dates}</span>}{l.details && <span>. {l.details}</span>}</p>
        ))}
      </section>
    )}

    {education.length > 0 && (
      <section>
        <h2>Education</h2>
        {education.map((e) => (
          <article>
            <div class="row"><p><strong>{e.school}</strong></p><span class="date">{e.end}</span></div>
            <p>{[e.degree, e.details].filter(Boolean).join(" · ")}</p>
          </article>
        ))}
      </section>
    )}
  </div>
</div>
