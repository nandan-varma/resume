---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { FileText, Search, UserRound } from "lucide-react";
import CommandPalette from "@/components/CommandPalette";
import SignOutButton from "@/components/SignOutButton";
import ThemeToggle from "@/components/ThemeToggle";
import { Toaster } from "@/components/Toaster";
import { buttonVariants } from "@/components/ui/variants";
import { cn } from "@/lib/cn";

type Props = { title?: string; description?: string; width?: "wide" | "text" };
const {
  title,
  description = "Find a job, then get a resume and cover letter written for it.",
  width = "wide",
} = Astro.props;

const { user } = Astro.locals;
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Find jobs", Icon: Search },
  { href: "/resumes", label: "My resumes", Icon: FileText },
  { href: "/profile", label: "Profile", Icon: UserRound },
];
const isActive = (href: string) =>
  href === "/"
    ? path === "/" || path.startsWith("/jobs")
    : path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/brand/icon.svg" />
    <title>{title ? `${title} · JobMatch` : "JobMatch"}</title>
    <ClientRouter />
    <script is:inline>
      // Set the theme before the page paints: the saved choice, else the system setting.
      // Page transitions replace <html>'s attributes, so it is applied again after each swap.
      const applyTheme = (doc) => {
        let dark = matchMedia("(prefers-color-scheme: dark)").matches;
        try {
          const saved = localStorage.getItem("theme");
          if (saved) dark = saved === "dark";
        } catch {}
        doc.documentElement.dataset.theme = dark ? "dark" : "light";
      };
      applyTheme(document);
      document.addEventListener("astro:before-swap", (e) => applyTheme(e.newDocument));
    </script>
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground">Skip to content</a>

    <header class="sticky top-0 z-30 border-b bg-background/95 backdrop-blur print:hidden">
      <div class="mx-auto flex h-12 max-w-[96rem] items-center gap-1 px-3 sm:px-6 lg:px-10">
        <a href="/" class="row-hover mr-2 flex h-8 items-center gap-2 rounded-md px-2 font-semibold">
          <img src="/brand/icon.svg" alt="" class="size-5 rounded-[4px]" />JobMatch
        </a>
        <nav aria-label="Main" class="hidden items-center gap-0.5 md:flex">
          {links.map(({ href, label, Icon }) => (
            <a
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
              class={cn(
                "row-hover flex h-8 items-center gap-1.5 rounded-md px-2.5 text-muted-foreground",
                isActive(href) && "bg-accent font-medium text-foreground",
              )}
            ><Icon className="size-4" />{label}</a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-1">
          <button
            type="button"
            id="palette-open"
            class="row-hover hidden h-8 items-center gap-2 rounded-md border px-2.5 text-muted-foreground lg:flex"
            aria-label="Quick jump"
          >
            <Search className="size-3.5" /> Jump to… <kbd class="rounded border px-1 text-xs">⌘K</kbd>
          </button>
          <ThemeToggle client:load />
          {user ? (
            <>
              <span class="hidden max-w-48 truncate text-xs text-muted-foreground sm:inline">{user.name || user.email}</span>
              <SignOutButton client:load />
            </>
          ) : (
            <a href={`/login?next=${encodeURIComponent(path)}`} class={buttonVariants({ size: "sm" })}>Sign in</a>
          )}
        </div>
      </div>
    </header>

    <main
      id="main"
      class={cn(
        "mx-auto w-full px-4 pt-6 pb-28 sm:px-8 lg:px-12 md:pt-8 md:pb-24 print:max-w-none print:p-0",
        width === "wide" ? "max-w-[96rem]" : "max-w-4xl",
      )}
    >
      <div class="page-in"><slot /></div>
    </main>

    <!-- Phones: the same three places, one thumb away. -->
    <nav aria-label="Main" class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-3 border-t bg-background/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden print:hidden">
      {links.map(({ href, label, Icon }) => (
        <a
          href={href}
          aria-current={isActive(href) ? "page" : undefined}
          class={cn(
            "flex flex-col items-center gap-0.5 py-2 text-xs text-muted-foreground",
            isActive(href) && "font-medium text-foreground",
          )}
        ><Icon className="size-5" strokeWidth={isActive(href) ? 2.25 : 1.75} />{label}</a>
      ))}
    </nav>

    <Toaster client:load />
    <CommandPalette client:idle signedIn={Boolean(user)} />
    <script>
      // One delegated listener survives page transitions.
      document.addEventListener("click", (e) => {
        if ((e.target as Element).closest("#palette-open")) {
          dispatchEvent(new Event("open-palette"));
        }
      });
    </script>
  </body>
</html>
