---
import "@/styles/global.css";
import SignOutButton from "@/components/SignOutButton";
import { Toaster } from "@/components/Toaster";
import { buttonVariants } from "@/components/ui/variants";
import { cn } from "@/lib/cn";

type Props = {
  title?: string;
  description?: string;
  width?: "narrow" | "wide";
};
const {
  title,
  description = "Find a job, then get a resume and cover letter written for it.",
  width = "wide",
} = Astro.props;

const { user } = Astro.locals;
const links = [
  { href: "/", label: "Find jobs" },
  { href: "/resumes", label: "My resumes" },
  { href: "/profile", label: "My details" },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/"
    ? path === "/" || path.startsWith("/jobs")
    : path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/icon.svg" />
    <title>{title ? `${title} · JobMatch` : "JobMatch"}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground">Skip to content</a>
    <header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur print:hidden">
      <div class="mx-auto flex h-16 max-w-5xl items-center gap-2 px-4 sm:gap-4">
        <a href="/" class="flex items-center gap-2 font-semibold">
          <img src="/brand/icon.svg" alt="" class="size-7" />
          <span class="hidden sm:inline">JobMatch</span>
        </a>
        <nav aria-label="Main" class="flex gap-1 text-sm">
          {links.map((l) => (
            <a
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              class={cn(
                "rounded-md px-2.5 py-2 text-muted-foreground transition-colors hover:text-foreground sm:px-3",
                isActive(l.href) && "bg-accent font-medium text-foreground",
              )}
            >{l.label}</a>
          ))}
        </nav>
        <div class="ml-auto">
          {user ? <SignOutButton client:load /> : (
            <a href={`/login?next=${encodeURIComponent(path)}`} class={buttonVariants({ size: "sm" })}>Sign in</a>
          )}
        </div>
      </div>
    </header>
    <main id="main" class={cn("mx-auto w-full flex-1 px-4 py-8 print:max-w-none print:p-0", width === "narrow" ? "max-w-xl" : "max-w-5xl")}>
      <slot />
    </main>
    <footer class="border-t py-6 text-center text-xs text-muted-foreground print:hidden">
      Jobs from <a class="underline underline-offset-2" href="https://tallo.nandan.fyi">Tallo</a>.
      Always read a resume before you send it.
    </footer>
    <Toaster client:load />
  </body>
</html>
