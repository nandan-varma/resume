{
  "name": "jobmatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "check": "biome check . && astro check",
    "fix": "biome check --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "gen:tallo": "openapi-typescript https://tallo.nandan.fyi/v1/openapi.json -o src/lib/tallo-api.d.ts",
    "gen:types": "wrangler types",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@rjsf/core": "^6.11.1",
    "@rjsf/shadcn": "^6.11.1",
    "@rjsf/utils": "^6.11.1",
    "@rjsf/validator-ajv8": "^6.11.1",
    "@tailwindcss/vite": "^4.3.5",
    "ai": "^7.0.181",
    "astro": "^7.4.13",
    "better-auth": "^1.7.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.79.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.9",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
