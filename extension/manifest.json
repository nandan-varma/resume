{
  "manifest_version": 3,
  "name": "JobMatch - Resume Analyzer",
  "version": "1.1.0",
  "description": "See your resume match score on LinkedIn job pages",
  "homepage_url": "http://localhost:3000",
  "permissions": ["cookies", "storage", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "css": ["card.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobMatch"
  }
}
