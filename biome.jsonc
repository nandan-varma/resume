{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!public",
      "!migrations",
      "!src/lib/tallo-api.d.ts",
      "!worker-configuration.d.ts",
      "!.astro"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": { "enabled": true },
  "overrides": [
    {
      // The printable resume must beat the screen styles and the editing aids, so print
      // and measuring rules use !important on purpose; specificity order is deliberate.
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": { "useImportType": "off" }
        }
      }
    }
  ]
}
